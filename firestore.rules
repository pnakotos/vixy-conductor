rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for security validation
    function isNonEmptyString(field, maxLen) {
      return request.resource.data[field] is string 
          && request.resource.data[field].size() > 0 
          && request.resource.data[field].size() <= maxLen;
    }

    function isNumber(field) {
      return request.resource.data[field] is number || request.resource.data[field] is int;
    }

    // Drivers collection
    match /drivers/{driverId} {
      allow read: if true;
      allow write: if isNonEmptyString('cedula', 30) 
                   && isNonEmptyString('fullName', 100) 
                   && isNonEmptyString('plateNumber', 20);
    }

    // Trips collection
    match /trips/{tripId} {
      allow read: if true;
      allow write: if isNonEmptyString('id', 80)
                   && isNonEmptyString('status', 30)
                   && isNumber('fareUsd');
    }

    // Wallet Transactions collection
    match /transactions/{transactionId} {
      allow read: if true;
      allow write: if isNonEmptyString('id', 80)
                   && isNonEmptyString('type', 30)
                   && isNumber('amountUsd');
    }
  }
}
