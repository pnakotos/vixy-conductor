# Copia este archivo a php-api/.env en el servidor de vhixy.site y completa
# los valores reales. NUNCA subas el .env real al repositorio.

# Base de datos MySQL/MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vhixy_site
DB_USER=
DB_PASS=

# Debe coincidir EXACTAMENTE con VITE_INTERCONNECTION_KEY del frontend
# (Vixy Driver y Vixy Passenger deben usar la MISMA clave)
VIXY_INTERCONNECTION_KEY=

# Orígenes permitidos separados por coma, o "*" para cualquiera.
# Ejemplo recomendado en producción:
# VIXY_ALLOWED_ORIGINS=https://www.vhixy.site,capacitor://localhost,https://localhost
VIXY_ALLOWED_ORIGINS=*
